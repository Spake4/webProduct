APP_NAME=AI Image Editor
DEBUG=false

# Database (не менять если используешь docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_editor

# Redis (не менять если используешь docker-compose)
REDIS_URL=redis://localhost:6379/0

# JWT — ОБЯЗАТЕЛЬНО СМЕНИТЬ на длинную случайную строку!
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_HERE

# Storage — MinIO (не менять endpoint если используешь docker-compose)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ai-editor
# ЗАМЕНИТЬ на публичный IP или домен сервера
STORAGE_PUBLIC_URL=http://YOUR_SERVER_IP:9000/ai-editor

# ComfyUI (если на том же сервере — оставить как есть)
COMFYUI_URL=http://localhost:8188

# CORS — добавить IP/домен сервера
ALLOWED_ORIGINS=["http://YOUR_SERVER_IP:3000","http://localhost:3000"]
